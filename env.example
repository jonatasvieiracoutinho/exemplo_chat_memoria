# Arquivo de configuração de variáveis de ambiente
# Copie este arquivo para .env e preencha com suas credenciais

# ═══════════════════════════════════════════════════════════════════════
# VARIÁVEIS OBRIGATÓRIAS
# ═══════════════════════════════════════════════════════════════════════
# O sistema falhará se qualquer uma estiver faltando ou inválida

# API Key da OpenAI
# Obtenha sua chave em: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-sua-chave-api-aqui

# Modelo padrão a ser usado
# Opções: gpt-4o-mini, gpt-4o, gpt-3.5-turbo, gpt-4, gpt-5-mini, gpt-5, etc
# NOTA: modelos de reasoning (gpt-5*, o1/o3/o4) têm regras diferentes —
# veja as observações em OPENAI_TEMPERATURE e OPENAI_MAX_TOKENS abaixo.
OPENAI_MODEL=gpt-4o-mini

# Temperatura para geração de respostas
# Valores entre 0.0 (mais determinístico) e 2.0 (mais criativo)
# NOTA: modelos de reasoning (gpt-5*, o-series) ignoram este valor — eles só
# aceitam o padrão (1). A aplicação omite o parâmetro automaticamente nesses casos.
OPENAI_TEMPERATURE=0.7

# Máximo de tokens por resposta
# NOTA: em modelos de reasoning (gpt-5*, o-series) este limite inclui os tokens
# de raciocínio internos; valores baixos podem gerar respostas vazias. Suba para
# 2000+ se usar esses modelos. A aplicação envia o parâmetro correto da API
# (max_completion_tokens) automaticamente para esses modelos.
OPENAI_MAX_TOKENS=1000

# ═══════════════════════════════════════════════════════════════════════
# VARIÁVEIS OPCIONAIS - CONEXÃO
# ═══════════════════════════════════════════════════════════════════════

# URL Base da API OpenAI (OPCIONAL)
# Use esta variável para conectar a provedores compatíveis com o padrão OpenAI
# Se NÃO configurada, usará o endpoint padrão da OpenAI (https://api.openai.com/v1)
# 
# Casos de uso:
#   - Azure OpenAI Service: https://SEU-RECURSO.openai.azure.com
#   - Ollama (local): http://localhost:11434/v1
#   - LM Studio (local): http://localhost:1234/v1
#   - Outros provedores compatíveis com API OpenAI
#
# IMPORTANTE: A URL deve começar com http:// ou https://
# Deixe comentado para usar o endpoint padrão da OpenAI
#OPENAI_BASE_URL=https://api.openai.com/v1

# Streaming da resposta (OPCIONAL)
# Se "true", a resposta do assistente é exibida token a token conforme chega
# da API, em vez de aparecer toda de uma vez ao final.
# Valores aceitos: true ou false
# Deixe comentado ou use false para receber a resposta completa de uma vez.
#OPENAI_STREAM=false

# ═══════════════════════════════════════════════════════════════════════
# VARIÁVEIS OPCIONAIS - GERENCIAMENTO DE MEMÓRIA
# ═══════════════════════════════════════════════════════════════════════
# Estas configurações podem ser omitidas. Se não configuradas, as 
# funcionalidades correspondentes ficarão desabilitadas.

# Sliding Window - Janela Deslizante
# Define o número máximo de PARES de mensagens (user+assistant) a manter
# Quando o limite é atingido, as mensagens mais antigas são descartadas
# automaticamente, mantendo apenas as mais recentes.
# 
# Valores sugeridos:
#   2-4  : Conversas curtas, FAQ, respostas rápidas
#   6-8  : Conversas gerais (recomendado)
#   10-16: Análises complexas que requerem mais contexto
#
# Exemplo: JANELA_MAX=8 mantém 16 mensagens (8 do usuário + 8 do assistente)
# Deixe comentado para desabilitar o sliding window
#JANELA_MAX=8

# Monitoramento de Tokens
# Define o limite máximo de tokens para alertas e recomendações
# O sistema calculará automaticamente 4 níveis de alerta:
#   🟢 Verde   (0-33%):   Uso normal, nenhuma ação necessária
#   🟡 Amarelo (33-66%):  Atenção, começando a usar mais memória
#   🟠 Laranja (66-99%):  Atenção aumentada, aproximando do limite
#   🔴 Vermelho (≥100%):  CRÍTICO - recomenda limpeza imediata
#
# Valores sugeridos:
#   500-800:  Para conversas curtas e econômicas
#   1000-1500: Para uso geral (recomendado)
#   2000+:     Para conversas longas e complexas
#
# Ao atingir o nível vermelho, o sistema exibirá um alerta sugerindo
# executar limpar_historico() ou ajustar JANELA_MAX
# Deixe comentado para desabilitar o monitoramento
#LIMITE_MAXIMO=1000

# Modo Debug
# Ativa logging detalhado em arquivos logs/chat_debug_TIMESTAMP.log
# Cada sessão gera um arquivo separado com informações completas:
#   - Todas as mensagens enviadas e recebidas
#   - System prompt utilizado
#   - Parâmetros do modelo (temperature, max_tokens)
#   - Histórico completo a cada interação
#   - Status de memória (tokens, janela, alertas)
#   - Ações executadas (limpeza, sliding window)
#
# Útil para:
#   - Desenvolvimento e debugging
#   - Auditoria de conversas
#   - Análise de uso de tokens
#   - Aprendizado sobre gerenciamento de memória
#
# Valores aceitos: true ou false
# Deixe comentado ou use false para desabilitar
#MODO_DEBUG=false

